{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "files": ["**/*.{md,ts,json,yml,yaml}"],
  "ignorePaths": [
    "vendor/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".agents/**",
    ".claude/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "develop-skill-evals",
      "path": "./skills/develop-skill-evals/cspell-words.txt"
    },
    {
      "name": "grill-this-skill",
      "path": "./skills/grill-this-skill/cspell-words.txt"
    },
    {
      "name": "write-citations",
      "path": "./skills/write-citations/cspell-words.txt"
    },
    {
      "name": "research-references",
      "path": "./skills/research-references/cspell-words.txt"
    }
  ],
  "overrides": [
    {
      "filename": [
        "skills/develop-skill-evals/**/*",
        "specs/develop-skill-evals.md"
      ],
      "dictionaries": ["develop-skill-evals"]
    },
    {
      "filename": ["skills/grill-this-skill/**/*", "specs/grill-this-skill.md"],
      "dictionaries": ["grill-this-skill"]
    },
    {
      "filename": ["skills/write-citations/**/*", "specs/write-citations.md"],
      "dictionaries": ["write-citations"]
    },
    {
      "filename": [
        "skills/research-references/**/*",
        "specs/research-references.md"
      ],
      "dictionaries": ["research-references"]
    }
  ],
  "words": [
    "agentskills",
    "ahormati",
    "alnum",
    "cffconvert",
    "Dataplex",
    "dedented",
    "evals",
    "frontmatter",
    "Jamil",
    "metaprompting",
    "NFKC",
    "nothrow",
    "okf",
    "okf_version",
    "orcid",
    "ORCIDs",
    "projen",
    "promptfoo",
    "promptfooconfig",
    "promptlint",
    "realpath",
    "rovo",
    "Subdirs",
    "Valliani",
    "worktree",
    "worktrees",
    "Zentennial",
    "ΑΒΓΔ"
  ]
}
