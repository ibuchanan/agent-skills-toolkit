{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "files": ["**/*.{md,ts,json,yml,yaml}"],
  "ignorePaths": [
    "vendor/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".agents/**",
    ".claude/**",
    "skills/develop-skill/references/agent-skills-architecture-acquisition-security-path-forward.md",
    "skills/develop-skill/references/agent-skills-security-vulnerabilities-at-scale.md",
    "skills/develop-skill/references/skillject-stealthy-skill-prompt-injection.md",
    "skills/develop-skill/references/skills-are-new-apps-skill-os.md",
    "skills/develop-skill/references/skillsbench-agent-skills-benchmark.md",
    "skills/select-llm/assets/model-catalog.snapshot.json"
  ],
  "dictionaryDefinitions": [
    {
      "name": "select-llm",
      "path": "./skills/select-llm/cspell-words.txt"
    },
    {
      "name": "microskills",
      "path": "./specs/references/microskills/cspell-words.txt"
    },
    {
      "name": "develop-skill-evals",
      "path": "./skills/develop-skill-evals/cspell-words.txt"
    },
    {
      "name": "grill-this-skill",
      "path": "./skills/grill-this-skill/cspell-words.txt"
    },
    {
      "name": "write-citations",
      "path": "./skills/write-citations/cspell-words.txt"
    },
    {
      "name": "research-references",
      "path": "./skills/research-references/cspell-words.txt"
    }
  ],
  "overrides": [
    {
      "filename": ["skills/select-llm/**/*"],
      "dictionaries": ["select-llm"]
    },
    {
      "filename": [
        "cspell.json",
        "CHANGELOG.md",
        "specs/capture-microskill.md",
        "specs/develop-skill.md",
        "specs/references/microskills/**/*",
        "skills/capture-microskill/**/*",
        "skills/develop-skill/SKILL.md"
      ],
      "dictionaries": ["microskills"]
    },
    {
      "filename": [
        "skills/develop-skill-evals/**/*",
        "specs/develop-skill-evals.md"
      ],
      "dictionaries": ["develop-skill-evals"]
    },
    {
      "filename": ["skills/grill-this-skill/**/*", "specs/grill-this-skill.md"],
      "dictionaries": ["grill-this-skill"]
    },
    {
      "filename": ["skills/write-citations/**/*", "specs/write-citations.md"],
      "dictionaries": ["write-citations"]
    },
    {
      "filename": [
        "skills/research-references/**/*",
        "specs/research-references.md"
      ],
      "dictionaries": ["research-references"]
    }
  ],
  "words": [
    "AAID",
    "SKILLDIR",
    "bunx",
    "Docling",
    "duplicative",
    "Firecrawl",
    "ibuchanan",
    "minimise",
    "Mintlify",
    "pathlib",
    "pytest",
    "skillject",
    "skillsbench",
    "triggerability",
    "venv",
    "Zenodo",
    "Zotero",
    "agentskills",
    "ahormati",
    "alnum",
    "cffconvert",
    "Dataplex",
    "dedented",
    "evals",
    "frontmatter",
    "Jamil",
    "metaprompting",
    "NFKC",
    "nothrow",
    "okf",
    "okf_version",
    "orcid",
    "ORCIDs",
    "projen",
    "promptfoo",
    "promptfooconfig",
    "promptlint",
    "realpath",
    "rovo",
    "Subdirs",
    "Valliani",
    "worktree",
    "worktrees",
    "Zentennial",
    "ΑΒΓΔ"
  ]
}
