{
  "name": "agent-skills-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run build:scripts",
    "build:scripts": "tsc --project tsconfig.scripts.json && chmod +x scripts/*.js",
    "changelog": "git cliff",
    "check": "lefthook run pre-push --force",
    "clean": "rm -rf ./node_modules && rm -f package-lock.json && rm -rf ./dist && rm -rf ./scripts",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:biome": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:markdown": "markdownlint-cli2",
    "lint:spell": "cspell lint --gitignore",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24",
    "cspell": "^10.0.1",
    "git-cliff": "^2.13",
    "lefthook": "^2.1",
    "markdownlint-cli2": "^0.23.2",
    "promptlint-cli": "^1.3.0",
    "typescript": "^7.0",
    "vitest": "^4.1",
    "yaml": "^2.4.0",
    "zx": "^8.8"
  },
  "engines": {
    "node": "24.x"
  }
}
