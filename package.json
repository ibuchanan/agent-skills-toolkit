{
  "name": "agent-skills-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Agent skills for defining, researching, describing, evaluating, and citing skills.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibuchanan/agent-skills-toolkit.git"
  },
  "files": [
    "scripts/*",
    "skills/*/SKILL.md",
    "skills/*/references/**/*",
    "skills/*/assets/**/*",
    "skills/*/scripts/**/*",
    "skills/*/CITATION.cff",
    "CITATION.cff"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:scripts",
    "build:scripts": "bun run src/scripts/build.ts",
    "eval:research-references": "skills/research-references/evals/run.sh",
    "bootstrap": "cd vendor/agent-skills-eval && npm install && npm run build",
    "changelog": "git cliff",
    "check": "lefthook run pre-push --force",
    "clean": "rm -rf ./node_modules && rm -f bun.lock && rm -rf ./dist && rm -rf ./scripts",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:biome": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:markdown": "markdownlint-cli2",
    "lint:spell": "cspell lint --gitignore",
    "prepare": "bun run build",
    "test": "bun run bootstrap && bun test test/scripts/*.test.ts",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "setup": "lefthook install && bun run bootstrap"
  },
  "dependencies": {
    "yaml": "^2.9"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "@biomejs/biome": "2.5.5",
    "@types/bun": "^1.3",
    "cspell": "^10.0.1",
    "git-cliff": "^2.13",
    "lefthook": "^2.1",
    "markdownlint-cli2": "^0.23.2",
    "promptlint-cli": "^1.3.0",
    "typescript": "^7.0"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "bin": {
    "check-skill": "scripts/check-skill",
    "find-skills": "scripts/find-skills",
    "init-skill": "scripts/init-skill",
    "init-skill-eval": "scripts/init-skill-eval",
    "link-toolkit-skills": "scripts/link-toolkit-skills",
    "validate-cff": "scripts/validate-cff",
    "validate-okf": "scripts/validate-okf",
    "validate-skill": "scripts/validate-skill"
  }
}
